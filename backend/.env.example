# PayPal Developer Credentials (Sandbox default)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Security & Sentinel Engine Secrets
SENTINEL_POLICY_HMAC_SECRET=dev-sentinel-hmac-secret-change-in-production-32bytes
SENTINEL_MAX_SINGLE_TRANSACTION=1000.00
SENTINEL_MAX_DAILY_VELOCITY=5000.00
SENTINEL_EMERGENCY_KILLSWITCH=false

# Service Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME="PayAgent-Sentinel"
DEBUG=true
PORT=8000
HOST=0.0.0.0
